          },
          "400": {
            "description": "Bad Request"
          },
          "500": {
            "description": "Internal Server Error"
          }
        },
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "metadata": {
                    "type": "string",
                    "example": "{\"__proto__\":{\"allowedExtension\":\".html\"}}"
                  },
                  "file": {
                    "type": "string",
                    "format": "binary"
