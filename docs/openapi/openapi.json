    "/v2/integrations/supplier-orders/import": {
      "post": {
        "description": "Imports supplier order lines into the authenticated account's Resource Store order history. Supplier YAML is parsed with an unsafe executable function tag, and its postImport hook runs during import.",
        "responses": {
          "201": {
            "description": "Supplier orders were persisted and their IDs and normalized details are returned."
          },
          "400": {
            "description": "Bad Request"
          }
        }
      }
    },
    "/v2/reports/monthly": {
      "get": {
        "description": "Generates and caches a monthly statement from the authenticated account's profile and Resource Store orders. The period is joined into the account-specific file path without a containment check; authenticated responses are marked public-cacheable.",
        "parameters": [
          {
            "name": "period",
            "in": "query",
            "description": "Statement month in YYYY-MM format.",
            "schema": {
              "type": "string",
              "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
