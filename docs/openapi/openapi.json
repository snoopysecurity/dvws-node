    "/v2/users/profile-sharing": {
      "get": {
        "description": "Returns the authenticated account's profile-sharing settings.",
        "responses": {
          "200": {
            "description": "Profile-sharing settings"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      },
      "put": {
        "description": "Updates the authenticated account's profile-sharing settings.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["enabled", "partnerOrigin", "fields"],
                "properties": {
                  "enabled": { "type": "boolean" },
                  "partnerOrigin": { "type": "string", "format": "uri" },
                  "fields": {
                    "type": "array",
                    "items": { "type": "string", "enum": ["username", "email", "homeAddress"] }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Settings saved" },
          "400": { "description": "Invalid settings" },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/v2/profile-sharing/jsonp": {
      "get": {
        "description": "Returns the selected fields as JSONP when profile sharing is enabled. This endpoint intentionally does not validate the request origin.",
        "parameters": [
          {
            "name": "callback",
            "in": "query",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": { "description": "JavaScript callback with selected profile fields" },
          "400": { "description": "Invalid callback" },
          "401": { "description": "Invalid or missing auth_token cookie" },
          "403": { "description": "Sharing is disabled" }
        }
      }
    },
